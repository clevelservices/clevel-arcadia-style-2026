---
import { ui, CALENDAR_URL, EMAIL, SOCIAL, type Lang } from '../i18n/ui';
interface Props { lang: Lang; title: string; body: string }
const { lang, title, body } = Astro.props;
const t = ui[lang];
---
<section class="band band--canopy on-dark cta">
  <div class="wrap cta-inner">
    <h2>{title}</h2>
    <p class="lead">{body}</p>
    <div class="btn-row">
      <a class="btn btn--mint" href={CALENDAR_URL} target="_blank" rel="noopener">{t.bookCall}</a>
      <a class="btn btn--ghost" href={`mailto:${EMAIL}`}>{t.writeUs}</a>
      {SOCIAL.linkedin && <a class="btn btn--ghost" href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
      {SOCIAL.instagram && <a class="btn btn--ghost" href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a>}
    </div>
  </div>
</section>
<style>
  .cta-inner { display: grid; gap: 18px; justify-items: center; text-align: center; }
  .cta-inner h2 { font-size: clamp(2.2rem, 1.4rem + 3vw, 3.4rem); }
  .cta-inner .btn-row { justify-content: center; margin-top: 10px; }
</style>
