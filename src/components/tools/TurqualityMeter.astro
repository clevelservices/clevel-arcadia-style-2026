---
import type { Lang } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const groups = lang === 'tr'
  ? [
      { t: 'Marka', items: ['Markanız Türkiye’de tescilli.', 'Hedef pazarlarda marka tescil başvurunuz var.', 'Ürünlerinizi yurt dışında kendi markanızla satıyorsunuz.'] },
      { t: 'Pazar', items: ['Son yıllarda düzenli ihracatınız var.', 'Yurt dışında bayi, distribütör ya da kendi biriminiz var.', 'Hedef pazarlarınızı ve rakiplerinizi yazılı olarak tanımladınız.'] },
      { t: 'Kurum', items: ['Yazılı bir orta vadeli strateji ve iş planınız var.', 'Organizasyon şemanız ve görev tanımlarınız güncel.', 'Satış, stok ve finans verilerinizi tek sistemden raporlayabiliyorsunuz.', 'Mali tablolarınız bağımsız denetimden geçiyor.'] },
    ]
  : [
      { t: 'Brand', items: ['Your brand is registered in Turkey.', 'You have filed trademark applications in your target markets.', 'You sell abroad under your own brand.'] },
      { t: 'Market', items: ['You have exported regularly in recent years.', 'You have a dealer, distributor or your own unit abroad.', 'Your target markets and competitors are defined in writing.'] },
      { t: 'Company', items: ['You have a written medium-term strategy and business plan.', 'Your organisation chart and job descriptions are up to date.', 'You can report sales, stock and finance from one system.', 'Your financial statements are independently audited.'] },
    ];
const levels = lang === 'tr'
  ? [
      { min: 0, t: 'Henüz başlangıçtasınız.', d: 'Önce marka tescili, düzenli ihracat ve yazılı bir plan gibi temelleri kurmak gerekiyor. Bu aşamada başvuru erken olur.' },
      { min: 4, t: 'Yolun yarısındasınız.', d: 'Temelleriniz var ama programın beklediği kurumsal yapının bir kısmı eksik. Eksikleri başvurudan önce kapatmak, sonradan uğraşmaktan daha ucuzdur.' },
      { min: 8, t: 'Başvuruya yakınsınız.', d: 'Başvuru dosyasını kendi ekibinizle hazırlayabilirsiniz. Program süresince kurumsallaşma yol haritası ve harcama raporları ise ayrı ve düzenli bir iş yüküdür.' },
    ]
  : [
      { min: 0, t: 'You are at the start.', d: 'The basics come first: trademark registration, regular exports and a written plan. Applying now would be early.' },
      { min: 4, t: 'You are halfway there.', d: 'The basics are in place, but part of the structure the programme expects is missing. Closing the gaps before applying is cheaper than fixing them later.' },
      { min: 8, t: 'You are close to applying.', d: 'Your own team can prepare the application. The development roadmap and spending reports during the programme are a separate, regular workload.' },
    ];
const all = groups.flatMap((g) => g.items);
// Honeycomb positions for ten cells (rows of 3–4–3), in a 100×100 box.
const cells = [
  [32, 22], [50, 22], [68, 22],
  [23, 50], [41, 50], [59, 50], [77, 50],
  [32, 78], [50, 78], [68, 78],
];
const hex = (x: number, y: number, r = 9.6) =>
  [0, 1, 2, 3, 4, 5].map((k) => { const a = (Math.PI / 180) * (60 * k - 90); return `${(x + r * Math.cos(a)).toFixed(2)},${(y + r * Math.sin(a)).toFixed(2)}`; }).join(' ');
---
<div class="tq" data-tq>
  <div class="tq-form">
    {groups.map((g, gi) => (
      <fieldset>
        <legend>{g.t}</legend>
        {g.items.map((it, ii) => {
          const idx = groups.slice(0, gi).reduce((n, x) => n + x.items.length, 0) + ii;
          return <label class="tq-item"><input type="checkbox" data-i={idx} /><span>{it}</span></label>;
        })}
      </fieldset>
    ))}
  </div>
  <div class="tq-side">
    <svg viewBox="0 0 100 100" class="tq-comb" role="img" data-comb aria-label={`0 / ${all.length}`}>
      {cells.map(([x, y], i) => <polygon points={hex(x, y)} data-cell={i} />)}
    </svg>
    <p class="tq-count" aria-live="polite"><strong data-n>0</strong> / {all.length}</p>
    {levels.map((l, i) => (
      <div class="tq-level" data-level={l.min} hidden={i !== 0}>
        <h3>{l.t}</h3>
        <p class="muted">{l.d}</p>
      </div>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-tq]');
  if (root) {
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));
    const cells = Array.from(root.querySelectorAll<SVGPolygonElement>('[data-cell]'));
    const levels = Array.from(root.querySelectorAll<HTMLElement>('[data-level]'));
    const comb = root.querySelector('[data-comb]')!;
    const update = () => {
      const n = boxes.filter((b) => b.checked).length;
      cells.forEach((c, i) => c.classList.toggle('on', i < n));
      root.querySelector('[data-n]')!.textContent = String(n);
      comb.setAttribute('aria-label', `${n} / ${boxes.length}`);
      let active = levels[0];
      levels.forEach((l) => { if (n >= Number(l.dataset.level)) active = l; });
      levels.forEach((l) => (l.hidden = l !== active));
    };
    boxes.forEach((b) => b.addEventListener('change', update));
    update();
  }
</script>

<style>
  .tq { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  fieldset { border: 0; margin: 0 0 20px; padding: 0; min-width: 0; display: grid; gap: 8px; }
  legend { font-weight: 500; margin-bottom: 8px; padding: 0; }
  .tq-item { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; background: var(--cream); border: 1px solid var(--sage-pale); border-radius: 10px; cursor: pointer; font-size: var(--t-small); line-height: 1.45; }
  .tq-item:hover { border-color: var(--canopy); }
  .tq-item input { appearance: none; -webkit-appearance: none; margin: 1px 0 0; width: 18px; height: 18px; flex: none; border: 1.5px solid var(--sage); border-radius: 4px; background: var(--sheet); cursor: pointer; display: grid; place-items: center; }
  .tq-item input:checked { background: var(--canopy); border-color: var(--canopy); }
  .tq-item input:checked::after { content: ''; width: 5px; height: 9px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg) translate(-1px, -1px); }
  .tq-item:has(input:checked) { background: var(--mint-soft); border-color: var(--canopy); }
  .tq-item:has(input:focus-visible) { outline: 2px solid var(--s1); outline-offset: 2px; }
  .tq-side { position: sticky; top: 100px; display: grid; gap: 14px; justify-items: center; text-align: center; }
  .tq-comb { width: min(320px, 100%); }
  .tq-comb polygon { fill: var(--sage-pale); stroke: var(--sheet); stroke-width: 1.2; transition: fill .3s var(--ease); }
  .tq-comb polygon:global(.on) { fill: var(--s2); }
  .tq-comb polygon:global(.on):nth-child(3n) { fill: var(--canopy); }
  .tq-comb polygon:global(.on):nth-child(3n+2) { fill: var(--mint); }
  .tq-count { font-size: var(--t-sub); color: var(--slate); }
  .tq-count strong { font-weight: 500; color: var(--bark); font-size: 2rem; }
  .tq-level { display: grid; gap: 8px; max-width: 40ch; }
  .tq-level h3 { font-size: var(--t-h3); font-weight: 300; letter-spacing: -0.02em; }
  @media (max-width: 820px) { .tq { grid-template-columns: 1fr; } .tq-side { position: static; order: -1; } .tq-comb { width: 220px; } }
</style>
